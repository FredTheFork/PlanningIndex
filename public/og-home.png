<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Brand gradient background -->
  <rect width="1200" height="630" fill="url(#gradient)"/>
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1B3F7A"/>
      <stop offset="100%" style="stop-color:#2C68C4"/>
    </linearGradient>
  </defs>

  <!-- Logo area -->
  <text x="600" y="180" font-family="Inter, Arial, sans-serif" font-size="64" font-weight="800" fill="white" text-anchor="middle">
    Foundationary
  </text>

  <!-- Tagline -->
  <text x="600" y="260" font-family="Inter, Arial, sans-serif" font-size="32" fill="rgba(255,255,255,0.9)" text-anchor="middle">
    Business Foundations. Fast.
  </text>

  <!-- Value prop -->
  <text x="600" y="350" font-family="Inter, Arial, sans-serif" font-size="48" font-weight="700" fill="white" text-anchor="middle">
    10 Documents. 24 Hours. £79.
  </text>

  <!-- Subtitle -->
  <text x="600" y="420" font-family="Inter, Arial, sans-serif" font-size="24" fill="rgba(255,255,255,0.85)" text-anchor="middle">
    Professional business documents for UK sole traders
  </text>

  <!-- CTA hint -->
  <rect x="450" y="480" width="300" height="60" rx="8" fill="white"/>
  <text x="600" y="520" font-family="Inter, Arial, sans-serif" font-size="22" font-weight="600" fill="#1B3F7A" text-anchor="middle">
    Get Started →
  </text>
</svg>
